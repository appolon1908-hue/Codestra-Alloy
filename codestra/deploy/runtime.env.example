# Non-secret Codestra Alloy runtime contract.
# Certificates and private keys are external runtime secret files and never belong here.

# One Alloy instance represents one approved business on one server.
# Approved values: platform, codestra, moneybee, beyvra, breero, larim-a,
# transportation, booked4seasons, social, klyrow, telnexa, kyqra,
# restaurant, provisioning.
CODESTRA_BUSINESS=platform
CODESTRA_ENVIRONMENT=staging
CODESTRA_REGION=hetzner-eu
CODESTRA_SERVER=replace-with-canonical-server-name
CODESTRA_ALLOY_DEPLOYMENT_ID=replace-with-immutable-release-id

# The journal-capable source build uses Grafana's reviewed Alloy build image,
# pinned by digest. The final /bin/alloy is compiled from this repository's
# verified vendored tree with CGO and the promtail_journal_enabled build tag.
GO_BUILDER_IMAGE_NAME=grafana/alloy-build-image:v0.1.35
GO_BUILDER_IMAGE_DIGEST=9fa2a341b53503ce42cf9900c401d689a68ea67cdec6a20f53d72e3665fb8dc6

# This official Alloy image is a digest-pinned runtime substrate only. Its
# bundled executable is overwritten by the source-built /bin/alloy.
ALLOY_BASE_IMAGE_NAME=grafana/alloy:REPLACE_WITH_PINNED_VERSION
ALLOY_BASE_IMAGE_DIGEST=1111111111111111111111111111111111111111111111111111111111111111

# This digest remains a release output. A placeholder is not deployable and all
# source-image activation gates remain false until build, SBOM, signature and
# provenance evidence are recorded.
CODESTRA_ALLOY_IMAGE_NAME=ghcr.io/appolon1908-hue/codestra-alloy:REPLACE_WITH_RELEASE
CODESTRA_ALLOY_IMAGE_DIGEST=2222222222222222222222222222222222222222222222222222222222222222

# Private TLS write endpoint. Native Loki must remain private.
LOKI_PUSH_URL=https://loki-ingest.internal/loki/api/v1/push

# The log root must contain only the assigned business:
#   <application>/<service>/*.log
#   <application>/<service>/docker/*-json.log
# On shared servers, never point this to /var/lib/docker/containers or another
# global path containing unrelated businesses.
ALLOY_LOG_SOURCE_PATH=/srv/codestra-logs/platform

# Platform/dedicated-host profile: /run/log/journal
# Business profile on a shared host: an approved empty, Alloy-readable directory.
ALLOY_JOURNAL_SOURCE_PATH=/run/log/journal
ALLOY_MACHINE_ID_PATH=/etc/machine-id

CODESTRA_BUSINESS_LOG_NETWORK=codestra-logs-platform
CODESTRA_OBSERVABILITY_NETWORK=codestra-observability

# External secret object names only.
ALLOY_LOKI_CA_SECRET_NAME=alloy-loki-ca
ALLOY_CLIENT_CERT_SECRET_NAME=alloy-client-cert
ALLOY_CLIENT_KEY_SECRET_NAME=alloy-client-key
