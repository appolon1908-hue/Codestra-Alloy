# Copy outside Git, render per server, and provide secrets through OpenBao-issued files.
CODESTRA_BUSINESS=platform
CODESTRA_APPLICATION=shared-platform
CODESTRA_ENVIRONMENT=staging
CODESTRA_SERVER=observability-01
CODESTRA_REGION=eu-central
CODESTRA_DEPLOYMENT=git-sha-or-release-id
LOKI_PUSH_URL=https://loki.codestra.media/loki/api/v1/push
LOKI_TENANT_ID=platform
PROMETHEUS_REMOTE_WRITE_URL=https://prom.codestra.media/api/v1/write
OTEL_EXPORTER_OTLP_ENDPOINT=otel.codestra.media:4317

# Immutable images are supplied by release automation.
ALLOY_IMAGE=registry.example.invalid/alloy@sha256:replace-with-approved-digest
DOCKER_SOCKET_PROXY_IMAGE=registry.example.invalid/docker-socket-proxy@sha256:replace-with-approved-digest

# These paths point to files rendered outside the repository.
OBSERVABILITY_CA_FILE=/run/codestra/pki/observability-ca.pem
ALLOY_CLIENT_CERT_FILE=/run/codestra/pki/alloy-client.pem
ALLOY_CLIENT_KEY_FILE=/run/codestra/pki/alloy-client-key.pem
