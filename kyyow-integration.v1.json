{
  "schema": "kyyow.platform-component.v1",
  "repository": "appolon1908-hue/Codestra-Alloy",
  "component": "alloy",
  "authority": "telemetry-routing",
  "exposure": "private",
  "native_ports": [
    12345,
    4317,
    4318
  ],
  "inputs": [
    "opentelemetry:otlp",
    "node-exporter:metrics",
    "cadvisor:metrics",
    "redis-exporter:metrics",
    "blackbox-exporter:metrics",
    "postgres-exporter:metrics"
  ],
  "outputs": [
    "prometheus:metrics",
    "loki:logs",
    "tempo:traces"
  ],
  "controls": [
    "collection and routing only; no privileged application writes",
    "drop prohibited high-cardinality and PII labels",
    "native UI and receivers stay private",
    "backpressure and retry must not cross tenant boundaries"
  ],
  "identity": {
    "authority": "appolon1908-hue/Keycloak",
    "workload_identity_required": true,
    "anonymous_admin_access": false
  },
  "secrets": {
    "authority": "appolon1908-hue/Codestra-OpenBao",
    "secrets_in_git": false,
    "environment_plaintext_secrets": false
  },
  "operations": {
    "middleware_is_sole_odoo_writer": true,
    "grafana_read_only": true,
    "superset_read_only": true
  },
  "activation": {
    "source_contract_complete": true,
    "runtime_evidence_complete": false,
    "production_activation_authorized": false
  }
}
