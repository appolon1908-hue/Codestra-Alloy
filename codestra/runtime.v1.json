{
  "schemaVersion": "1.0",
  "component": "alloy",
  "role": "business-scoped-host-and-service-log-collection-agent",
  "canonicalHostname": "allo.codestra.media",
  "exposure": "internal_private",
  "status": "CONFIG_PREPARED_NOT_DEPLOYED",
  "businessScope": [
    "platform",
    "codestra",
    "moneybee",
    "beyvra",
    "breero",
    "larim-a",
    "transportation",
    "booked4seasons",
    "social",
    "klyrow",
    "telnexa",
    "kyqra",
    "restaurant",
    "provisioning"
  ],
  "instanceModel": {
    "scope": "one_business_one_server_boundary",
    "businessIdentitySource": "deployment_environment",
    "callerSuppliedBusinessIdentityTrusted": false,
    "crossBusinessCollectionDefault": "deny",
    "sharedServerRequiresSeparateLogRoots": true,
    "sharedServerJournalPolicy": "business_instances_mount_empty_directory",
    "platformOrDedicatedServerMayReadPersistentJournal": true
  },
  "collection": {
    "serviceLogRoot": "/var/log/codestra/<application>/<service>/*.log",
    "explicitContainerLogRoot": "/var/log/codestra/<application>/<service>/docker/*-json.log",
    "journalRoot": "/run/log/journal",
    "dockerSocket": false,
    "globalDockerContainerDirectory": false,
    "privilegedMode": false,
    "hostNetwork": false,
    "hostMetrics": false,
    "containerMetrics": false,
    "applicationOtlpGateway": false,
    "selfMetrics": true
  },
  "authorityBoundaries": {
    "nodeExporterOwnsHostMetrics": true,
    "cadvisorOwnsContainerMetrics": true,
    "opentelemetryOwnsApplicationOtlp": true,
    "lokiOwnsLogStorageAndQuery": true,
    "prometheusOwnsMetricsAndSlo": true,
    "grafanaOwnsPresentation": true,
    "businessMutation": false,
    "communicationsDelivery": false,
    "identityAuthority": false,
    "secretsAuthority": false,
    "financialOrTradingMutation": false
  },
  "requiredStreamLabels": [
    "codestra_business",
    "application",
    "service",
    "environment",
    "server",
    "region",
    "deployment",
    "log_source"
  ],
  "forbiddenStreamLabels": [
    "tenant_id",
    "tenant_name",
    "organization_id",
    "organization_name",
    "customer_id",
    "customer_name",
    "account_id",
    "user_id",
    "user_name",
    "email",
    "phone",
    "request_id",
    "correlation_id",
    "trace_id",
    "span_id",
    "message_id",
    "order_id",
    "workflow_id",
    "execution_id",
    "path",
    "filename",
    "url",
    "query_string",
    "db_statement",
    "exception_message",
    "container_id",
    "image_id",
    "pod_uid",
    "process_pid"
  ],
  "protectedStructuredFields": [
    "level",
    "event_family",
    "operation",
    "result",
    "error_code",
    "request_id",
    "correlation_id",
    "trace_id",
    "span_id",
    "deployment_sha"
  ],
  "redaction": {
    "beforeLokiWrite": true,
    "privateKeyMarkerLinesDropped": true,
    "credentialAndTokenValuesReplaced": true,
    "customerAndPersonValuesReplaced": true,
    "rawBodyAndDatabaseStatementValuesReplaced": true,
    "emailAddressesReplaced": true,
    "applicationDataMinimizationStillRequired": true
  },
  "delivery": {
    "lokiTenantIdSource": "CODESTRA_BUSINESS",
    "mutualTls": true,
    "certificateVerification": true,
    "walEnabled": true,
    "boundedBackoff": true,
    "durableStoragePath": "/var/lib/alloy",
    "businessSystemOfRecord": false
  },
  "runtime": {
    "uid": 10001,
    "gid": 10001,
    "readOnlyRootFilesystem": true,
    "dropAllCapabilities": true,
    "noNewPrivileges": true,
    "nativeHostPortPublished": false,
    "nativeAdminLoopbackPort": 12345,
    "privateReadOnlyPort": 12346,
    "privateReadOnlyRoutes": [
      "/-/healthy",
      "/-/ready",
      "/metrics"
    ],
    "nativeAdminRoutesReachableFromPeers": false,
    "dockerSocketMounted": false,
    "resourceLimitsRequired": true,
    "immutableImageRequired": true
  },
  "financialTradingBoundary": {
    "business": "beyvra",
    "rule": "Alloy may collect redacted operational logs about latency, provider health, reconciliation and capability state. It must not collect broker or exchange credentials, signing material, raw order payloads, account identifiers, authoritative balances, positions or executions, and it never receives trading authority."
  },
  "activation": {
    "alloyImageBuilt": false,
    "immutableDigestRecorded": false,
    "businessLogRootPrepared": false,
    "nonRootReadAclProven": false,
    "journalBoundaryProven": false,
    "mtlsCertificateIssued": false,
    "mtlsRevocationTested": false,
    "lokiTenantWriteTestPassed": false,
    "crossBusinessDenialTestPassed": false,
    "redactionFixturesPassed": false,
    "walRestartRecoveryPassed": false,
    "queueCapacityTestPassed": false,
    "prometheusSelfScrapePassed": false,
    "productionApproved": false,
    "deploymentEnabled": false
  }
}
